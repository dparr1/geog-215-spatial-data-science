// Cloudflare Worker that serves the gated book at https://geog215.org.
//
// Cloudflare Workers Builds is connected to this repo: on every push to main
// it runs `npx wrangler deploy`, which first runs build.command (installs
// Quarto and renders the book with the `geog215` profile, adding the Supabase
// sign-in gate), then uploads _book/.
//
// geog215.org is attached to this Worker in the dashboard
// (Workers & Pages > geog-215-spatial-data-science > Settings > Domains & Routes).
//
// Not used for daveparr.com/geog215/: that public copy is rendered by the
// GitHub Action and committed to the daveparr.com repo.
{
  "name": "geog-215-spatial-data-science",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bash scripts/cloudflare-build.sh"
  },
  "assets": {
    "directory": "./_book"
  }
}
